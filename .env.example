# --- Server ---
PORT=8080

# --- Database (cocok dengan docker-compose.yml) ---
DB_DSN=autograder:autograder_pass@tcp(127.0.0.1:3306)/autograder_db?parseTime=true&charset=utf8mb4&loc=Local

# --- Auth (gunakan dua nilai BERBEDA, minimal 32 karakter, mis: openssl rand -hex 32) ---
JWT_SECRET=<your-jwt-access-secret>
JWT_REFRESH_SECRET=<your-jwt-refresh-secret>

# --- AI & Code Execution ---
GEMINI_API_KEY=<your-gemini-api-key>
JUDGE0_API_URL=http://localhost:2358

# --- Optional ---
# Daftar origin frontend yang dipercaya, pisahkan dengan koma (tidak boleh "*")
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Set true jika backend dilayani lewat HTTPS (cookie refresh token menjadi Secure)
COOKIE_SECURE=false
# Model Gemini yang dipakai untuk generate testcase
GEMINI_MODEL=gemini-2.5-flash
